# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/database"
DIRECT_URL="postgresql://username:password@localhost:5432/database"

# SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="notificaciones@example.com"
SMTP_PASS="tu_contrasena_aqui"
SMTP_FROM="Sistema Metrológico <notificaciones@example.com>"
NOTIFICATION_EMAILS="destinatario@example.com"
NOTIFICATION_CC_EMAILS="copia@example.com"


# Seguridad (obligatorio en producción)
# Genere un valor aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="cambie_esto_por_un_valor_aleatorio_de_al_menos_32_caracteres"
# Vercel Cron envía "Authorization: Bearer <CRON_SECRET>" a /api/cron/*
CRON_SECRET="otro_valor_aleatorio"
# Dominio usado cuando el usuario inicia sesión solo con su nombre de usuario
DEFAULT_EMAIL_DOMAIN="polifusion.cl"
# Habilita /api/seed y /api/test_db en producción (solo Admin). Déjelo en false.
ALLOW_SEED="false"
