// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
//  INSTRUMENTOS Y EQUIPOS
// ─────────────────────────────────────────────
model InstrumentoEquipo {
  ID_Equipo                 String    @id
  Tipo                      String                    // EQUIPO | INSTRUMENTO
  Codigo_Interno            String
  Nombre_Equipo             String
  Marca                     String?
  Modelo                    String?
  Serie                     String?
  Rango_Medida              String?
  Resolucion                String?
  Tolerancia_Aceptable      Float
  Unidad_Tolerancia         String?
  Area_Asignada             String?
  Responsable               String?
  Periodicidad_Meses        Int
  Fecha_Ultima_Verificacion DateTime?
  Fecha_Proximo_Control     DateTime?
  Foto_Equipo               String?
  Fecha_Ingreso             DateTime?
  Estado String                    // OPERATIVO | OPERATIVO_CON_DETALLES | VENCIDO | MANTENIMIENTO | FUERA_DE_SERVICIO | DE_BAJA_OBSOLETO
  Detalles_Estado           String?
  Tiene_Solucion            Boolean?  @default(true)
  Requiere_Seguimiento      Boolean?  @default(false)
  PDF_Certificado               String?
  Fecha_Vencimiento_Certificado DateTime?
  N_Certificado                 String?
  Proveedor_Servicio            String?
  Magnitud                      String?               // TEMPERATURA | MASA | LONGITUD | PRESION | TIEMPO | ELECTRICA | VOLUMEN | OTRA (permite múltiples separadas por coma)
  Accesorios                    String?
  Insumos                       String?

  historiales               HistorialVerificacion[]

  @@index([Codigo_Interno])
  @@index([Tipo])
}

// ─────────────────────────────────────────────
//  PATRONES DE REFERENCIA
// ─────────────────────────────────────────────
model PatronReferencia {
  ID_Patron                     String    @id
  Codigo                        String
  Nombre_Patron                 String
  Fecha_Calibracion_Externa     DateTime?
  Fecha_Vencimiento_Certificado DateTime?
  N_Certificado                 String?
  Proveedor_Laboratorio         String?
  PDF_Certificado               String?
  Estado_Vigencia               String                // VIGENTE | VENCIDO | SIN CERTIFICADO
  Magnitud                      String?               // TEMPERATURA | MASA | LONGITUD | PRESION | TIEMPO | ELECTRICA | VOLUMEN | OTRA

  historiales                   HistorialVerificacion[]

  @@index([Codigo])
}

// ─────────────────────────────────────────────
//  HISTORIAL DE VERIFICACIONES
// ─────────────────────────────────────────────
model HistorialVerificacion {
  ID_Log                  String    @id @default(uuid())
  FK_ID_Equipo            String
  Fecha_Ejecucion         DateTime  @default(now())
  FK_ID_Patron_Usado      String?
  Medida_Instrumento      Float?
  Medida_Patron           Float?
  Variacion_Calculada     Float?
  Resultado_Status        String                        // APTO | NO_APTO | OPERATIVO | ACCION_PENDIENTE
  Tecnico_Ejecutor        String
  Firma_Digital           String?
  Observaciones           String?
  PDF_Certificado_interno String?
  Tipo_Verificacion       String?   @default("CALIBRACION") // OPERATIVIDAD | CALIBRACION
  Acciones_Pendientes     String?
  Estado_Seguimiento      String?                       // PENDIENTE | COMPLETADO | N/A

  equipo   InstrumentoEquipo  @relation(fields: [FK_ID_Equipo], references: [ID_Equipo])
  patron   PatronReferencia?  @relation(fields: [FK_ID_Patron_Usado], references: [ID_Patron])

  @@index([FK_ID_Equipo])
  @@index([Fecha_Ejecucion])
}

// ─────────────────────────────────────────────
//  USUARIOS
// ─────────────────────────────────────────────
model Usuario {
  Email         String  @id
  Nombre        String
  Rol           String  // Admin | Técnico | Lector
  Firma_Imagen  String?
}
